from typing import List, Tuple

def find_max_subarray(numbers: List[int]) -> Tuple[int, List[int]]:
    """
    Находит непрерывный подмассив с наибольшей суммой.
    Возвращает кортеж: (максимальная сумма, сам подмассив).
    """
    if not numbers:
        return 0, []

    max_so_far = numbers[0]
    current_max = numbers[0]
    
    # Индексы для отслеживания границ лучшего подмассива
    start = end = s = 0

    for i in range(1, len(numbers)):
        # Если текущий элемент больше, чем сумма предыдущих + текущий,
        # начинаем новый подмассив с этой позиции
        if numbers[i] > current_max + numbers[i]:
            current_max = numbers[i]
            s = i
        else:
            current_max += numbers[i]

        # Обновляем глобальный максимум
        if current_max > max_so_far:
            max_so_far = current_max
            start = s
            end = i

    return max_so_far, numbers[start:end + 1]

nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
max_sum, subarray = find_max_subarray(nums)

print(f"Максимальная сумма: {max_sum}")
print(f"Подмассив: {subarray}")

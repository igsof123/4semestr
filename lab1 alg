def get_orientation(p, q, r):
    """Определяет ориентацию тройки точек (поворот).
    0 - коллинеарны, 1 - по часовой, 2 - против часовой."""
    val = (q[1] - p[1]) * (r[0] - q[0]) - (q[0] - p[0]) * (r[1] - q[1])
    if val == 0: return 0
    return 1 if val > 0 else 2


def convex_hull(points):
    n = len(points)
    if n < 3:
        return "Выпуклая оболочка не существует (нужно минимум 3 точки)"

    # Находим самую левую точку
    leftmost = 0
    for i in range(1, n):
        if points[i][0] < points[leftmost][0]:
            leftmost = i

    hull = []
    p = leftmost
    while True:
        hull.append(points[p])
        # Ищем следующую точку q такую, чтобы все остальные точки r
        # были справа от вектора pq
        q = (p + 1) % n
        for r in range(n):
            if get_orientation(points[p], points[r], points[q]) == 2:
                q = r
        p = q
        if p == leftmost:
            break

    return hull



pts = [(0, 3), (2, 2), (1, 1), (2, 1), (3, 0), (0, 0), (3, 3)]
print("Точки выпуклой оболочки:", convex_hull(pts))

#Реализовать алгоритм Кнута-Морриса-Пратта для поиска по образцу


def compute_lps(pattern):
    """
    Вычисляет массив LPS (Longest Proper Prefix which is also Suffix).
    """
    m = len(pattern)
    lps = [0] * m
    length = 0  # длина предыдущего самого длинного префикса-суффикса
    i = 1

    while i < m:
        if pattern[i] == pattern[length]:
            length += 1
            lps[i] = length
            i += 1
        else:
            if length != 0:
                # Откатываемся к предыдущему возможному префиксу
                length = lps[length - 1]
            else:
                lps[i] = 0
                i += 1
    return lps


def kmp_search(text, pattern):
    """
    Поиск всех вхождений pattern в text за O(n + m).
    """
    n = len(text)
    m = len(pattern)

    if m == 0:
        return []

    lps = compute_lps(pattern)
    i = 0  # указатель для текста
    j = 0  # указатель для паттерна
    results = []

    while i < n:
        if pattern[j] == text[i]:
            i += 1
            j += 1

        if j == m:
            # Найдено вхождение!
            results.append(i - j)
            j = lps[j - 1]

        # Несовпадение после j совпадений
        elif i < n and pattern[j] != text[i]:
            if j != 0:
                # Вместо сброса в 0, используем массив lps
                j = lps[j - 1]
            else:
                i += 1

    return results


text = "ABABDABACDABABCABAB"
pattern = "ABABCABAB"
matches = kmp_search(text, pattern)

print(f"Текст: {text}")
print(f"Паттерн: {pattern}")
print(f"Индексы вхождений: {matches}")
